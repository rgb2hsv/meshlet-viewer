#version 460
#extension GL_EXT_mesh_shader : require
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

layout(local_size_x = MESH_GROUP_SIZE) in;
layout(triangles, max_vertices = MAX_MESHLET_VERTICES, max_primitives = MAX_MESHLET_TRIANGLES) out;

taskPayloadSharedEXT uint payloadMeshlets[TASK_GROUP_SIZE];

layout(location = 0) out vec3 outNormal[];
layout(location = 1) out vec3 outWorldPos[];
layout(location = 2) perprimitiveEXT flat out uint outMeshletTriangle[];
layout(location = 3) perprimitiveEXT flat out vec3 outAltitudes[];
layout(location = 4) perprimitiveEXT flat out uint outEdgeMask[];
layout(location = 5) out vec2 outUv[];

shared vec3 sharedPositions[MAX_MESHLET_VERTICES];

uint readTriangleByte(uint byteIndex)
{
    return (pc.meshletTriangles.d[byteIndex >> 2] >> ((byteIndex & 3u) * 8u)) & 0xffu;
}

void main()
{
    uint mi = payloadMeshlets[gl_WorkGroupID.x];
    Meshlet m = pc.meshlets.m[mi];
    mat4 viewProj = pc.globals.viewProj;

    SetMeshOutputsEXT(m.vertexCount, m.triangleCount);

    const bool uvGrid = (pc.globals.flags & FLAG_UV_GRID) != 0u;
    for (uint i = gl_LocalInvocationIndex; i < m.vertexCount; i += MESH_GROUP_SIZE)
    {
        uint vi = pc.meshletVertices.d[m.vertexOffset + i];
        Vertex v = pc.vertices.v[vi];
        outUv[i] = uvGrid ? pc.texcoords.t[vi] : vec2(0.0);
        vec3 p = vec3(v.px, v.py, v.pz);
        gl_MeshVerticesEXT[i].gl_Position = viewProj * vec4(p, 1.0);
        outNormal[i] = vec3(v.nx, v.ny, v.nz);
        outWorldPos[i] = p;
        sharedPositions[i] = p;
    }

    barrier(); // sharedPositions complete before triangles read them

    for (uint t = gl_LocalInvocationIndex; t < m.triangleCount; t += MESH_GROUP_SIZE)
    {
        uint base = m.triangleOffset + t * 3u;
        uvec3 tri = uvec3(readTriangleByte(base), readTriangleByte(base + 1u), readTriangleByte(base + 2u));
        gl_PrimitiveTriangleIndicesEXT[t] = tri;
        outMeshletTriangle[t] = (mi << TRI_BITS) | t;
        outAltitudes[t] = triangleAltitudes(sharedPositions[tri.x], sharedPositions[tri.y], sharedPositions[tri.z]);
        uint maskIndex = m.triangleOffset / 3u + t;
        outEdgeMask[t] = (pc.edgeMasks.d[maskIndex >> 2] >> ((maskIndex & 3u) * 8u)) & 7u;
    }

}
