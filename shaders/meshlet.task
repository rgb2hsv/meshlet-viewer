#version 460
#extension GL_EXT_mesh_shader : require
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

// One task invocation per cluster: either per candidate selected by the BVH traversal
// (lod_traverse.comp, automatic LOD) or per cluster of all levels with the LOD test done
// here (fixed level / no hierarchy). Survivors of frustum + normal cone culling get one
// mesh workgroup each.
layout(local_size_x = TASK_GROUP_SIZE) in;

taskPayloadSharedEXT uint payloadMeshlets[TASK_GROUP_SIZE];

shared uint visibleCount;
shared uint visibleTriangles;

bool isSelected(MeshletLod lod)
{
    Globals g = pc.globals;
    bool terminal = lod.coarseError >= TERMINAL_ERROR;
    if (g.lodMode == LOD_FIXED)
        return lod.level == g.lodLevel || (lod.level < g.lodLevel && terminal);

    // draw when the coarser version would be too coarse and this one is detailed enough
    bool coarseTooCoarse = terminal || projectedError(g, lod.coarseSphere, lod.coarseError) > g.lodThreshold;
    bool selfFineEnough = lod.selfError == 0.0 || projectedError(g, lod.selfSphere, lod.selfError) <= g.lodThreshold;
    return coarseTooCoarse && selfFineEnough;
}

bool isVisible(uint mi)
{
    Globals g = pc.globals;
    Bounds b = pc.bounds.b[mi];
    vec3 center = b.centerRadius.xyz;
    float radius = b.centerRadius.w;

    if ((g.flags & FLAG_FRUSTUM_CULL) != 0u && outsideFrustum(g, center, radius))
        return false;

    if ((g.flags & FLAG_CONE_CULL) != 0u)
    {
        // meshoptimizer: reject when the whole cluster faces away from the camera
        vec3 toCenter = center - g.lodCamera.xyz;
        if (dot(toCenter, b.coneAxisCutoff.xyz) >= b.coneAxisCutoff.w * length(toCenter) + radius)
            return false;
    }
    return true;
}

void main()
{
    if (gl_LocalInvocationIndex == 0)
    {
        visibleCount = 0;
        visibleTriangles = 0;
    }
    barrier();

    Globals g = pc.globals;
    const bool useCandidates = (g.flags & FLAG_LOD_CANDIDATES) != 0u;
    uint count = useCandidates ? g.traversal.candidateCount : g.meshletCount;

    uint index = gl_GlobalInvocationID.x;
    if (index < count)
    {
        uint mi = useCandidates ? g.candidates.d[index] : index;
        MeshletLod lod = pc.lods.l[mi];
        if ((useCandidates || isSelected(lod)) && isVisible(mi))
        {
            uint slot = atomicAdd(visibleCount, 1u);
            payloadMeshlets[slot] = mi;

            uint triangles = pc.meshlets.m[mi].triangleCount;
            uint level = min(lod.level, MAX_LOD_LEVELS - 1u);
            atomicAdd(visibleTriangles, triangles);
            atomicAdd(pc.stats.levelClusters[level], 1u);
            atomicAdd(pc.stats.levelTriangles[level], triangles);
        }
    }
    barrier();

    if (gl_LocalInvocationIndex == 0 && visibleCount > 0u)
    {
        atomicAdd(pc.stats.visibleMeshlets, visibleCount);
        atomicAdd(pc.stats.visibleTriangles, visibleTriangles);
    }

    EmitMeshTasksEXT(visibleCount, 1, 1);
}
